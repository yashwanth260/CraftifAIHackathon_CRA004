# AI Safety Sentinel 360 Environment Configuration

# Database
DATABASE_URL=sqlite:///storage/sentinel.db

# Vision Models
YOLO_PERSON_MODEL=yolov8n.pt
PPE_MODEL_PATH=

# Inference Thresholds
PERSON_CONFIDENCE_THRESHOLD=0.45
PPE_CONFIDENCE_THRESHOLD=0.50

# Pipeline Rules & Deduplication
DEDUPLICATION_WINDOW_SECONDS=10.0
EVIDENCE_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=250

# Server
HOST=127.0.0.1
PORT=8000
